# Plantilla: instalar-servicio.sh sustituye los valores entre @.
[Unit]
Description=Bot de stickers con sonido
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@DIRECTORIO@
Environment="PATH=@PATH@"
ExecStart="@NODE@" --env-file=.env dist/index.js
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
