# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# Obligatorio. Para arrancar el bot tienes que haber leído AVISO.md y aceptarlo descomentando esta línea.
# ACEPTO_AVISO=si

# Obligatorio. Números autorizados (con código de país, sin +), separados por comas.
# El bot ignora por completo a cualquier otro remitente.
ALLOWED_NUMBERS=34600111222

# Opcional. Duración máxima del audio del sticker, en segundos enteros entre 1 y 10.
MAX_SOUND_SECONDS=10

# Opcional. Carpeta de la sesión de WhatsApp (credenciales). Déjala fuera del repositorio.
AUTH_DIR=./auth

# Opcional. Número de la cuenta del bot, con código de país. Solo sirve para vincular con código si la
# app no envía el número; con QR no hace falta. La vinculación se pide desde la app o la API. Tras vincular, puedes vaciar esta línea.
PAIRING_PHONE=

# Opcional. Puerto de la API de control; solo escucha en 127.0.0.1.
CONTROL_PORT=8787

# Opcional. Archivo con el token de la API; se crea solo (permisos 0600). No lo subas ni lo compartas.
CONTROL_TOKEN_FILE=./control-token

# Opcional y apagado por defecto: si | no. Con «si», el bot solo procesa los videos que envías a tu
# propio chat (ignora ALLOWED_NUMBERS) y se pausa tras uno. Vincular tu número principal puede hacer
# que WhatsApp lo bloquee, aunque lo uses una sola vez. Desvincula al terminar.
MODO_CHAT_PROPIO=no

# Opcional. Formato del protocolo del sticker con sonido: sticker-field-26 | audio-sticker-134
SOUND_WIRE_FORMAT=sticker-field-26

# Opcional. Ruta absoluta al binario conversor-stickers (CLI en Rust) para generar el WebP del sticker.
# Si no se define, se usa ffmpeg.
# CONVERSOR_BIN=/ruta/a/conversor-stickers/target/release/conversor-stickers

# Opcional. Nivel de logs de pino: trace, debug, info, warn, error.
LOG_LEVEL=info
